{
    "height": 24,
    "modules-left": [
        "custom/menu", 
        "niri/workspaces", 
        "niri/window"
    ],
    "modules-center": [
        "group/hardware"
    ],
    "modules-right": [
        "niri/language",
        "battery",
        "backlight",
        "pulseaudio",
        "network",
        "clock",
        "tray",
        "custom/powermenu"
    ],

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "memory",
            "cpu"
        ]
    },

    "cpu": {
        "format": "  {usage}%"
    },

    "memory": {
        "format": "  {used} GiB"
    },

    "temperature": {
        "format": "  {temperatureC}°C"
    },

	  "custom/menu": {
		    "format": "{icon}",
		    "format-icons": "󱄅",
		    "on-click": "fuzzel",
		    "escape": true,
	      "tooltip": false
	  },

    "custom/powermenu": {
        "format": "{icon}",
        "format-icons": " 󰐥 ",
    		"on-click": "fuzzel",
	    	"escape": true,
		    "tooltip": false
    },

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate"
    },

    "niri/window": {
        "max-length": 50
    },

    "niri/language": {
        "format": "{short}"
    },

    "clock": {
        "format": "{:%H:%M}  ",
        "format-alt": "{:%A, %B %d, %Y}",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "   {essid} ({signalStrength}%)",
        "tooltip-format": "d{bandwidthDownBits}, u{bandwidthUpBits}",
        "format-disconnected": "󰖪  Disconnected", 
        "interval": 5,
        "max-length": 50
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "",
        "format-icons": {
            "headset": "",
            "default": ["", ""]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": ["", ""]
    }
}
