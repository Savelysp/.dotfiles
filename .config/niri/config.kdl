/////////////////////////
/////НАСТРОЙКИ ВВОДА/////
/////////////////////////

input {
    // Настройки клавиатуры 
    keyboard {
        // Включить numlock
        numlock

        // Переключение раскладок
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }

    // Настройки тачпада
    touchpad {
        tap
        natural-scroll
    }

    // Переключение фокуса окон мышью
    focus-follows-mouse
}


////////////////////////////
/////НАСТРОЙКИ МОНИТОРА/////
////////////////////////////

output "eDP-1" {
    // Масштабирование
    scale 1.25
}


//////////////////////////
/////ОТОБРАЖЕНИЕ ОКОН/////
//////////////////////////

layout {
    // Отступы
    gaps 12
    
    // Центрирование окон
    center-focused-column "never"

    // Пресеты пропорций
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    // Пропорции окон по умолчанию
    default-column-width { proportion 0.5; }

    // Рамки фокуса
    focus-ring {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
    
    // Стандартные рамки
    border {
        // off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // Тени
    shadow {
        off
    }

    // Резервирование пространства
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// Отключить панель над окнами
prefer-no-csd


///////////////////
/////АВТОСТАРТ/////
///////////////////

// Панель waybar
spawn-at-startup "waybar"
spawn-at-startup "mako"

// Обои
spawn-at-startup "awww-daemon"
spawn-sh-at-startup "awww img \"$(find ~/wallpapers -type f | shuf -n1)\""

spawn-at-startup "emacs --daemon"

// Буфен обмена
spawn-at-startup "wl-paste" "--type" "text"
spawn-at-startup "wl-paste" "--type" "image"

// Отключить окно горячих клавиш на старте
hotkey-overlay {
    skip-at-startup
}


//////////////////
/////АНИМАЦИИ/////
//////////////////

animations {
    // off
    // slowdown 3.0
}


//////////////////////////
/////ПРАВИЛА ДЛЯ ОКОН/////
//////////////////////////

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    geometry-corner-radius 6 
    clip-to-geometry true
}

// Сохранение скриншотов
screenshot-path "~/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


///////////////
/////БИНДЫ/////
///////////////

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Общий обзор
    Mod+O repeat=false { toggle-overview; }

    // Приложения
    Mod+D        hotkey-overlay-title="Open fuzzel"    { spawn "fuzzel"; }
    Mod+Return   hotkey-overlay-title="Open alacritty" { spawn "alacritty"; }
    Mod+Shift+F  hotkey-overlay-title="Open firefox"   { spawn "firefox"; }
    Mod+Shift+T  hotkey-overlay-title="Open telegram"  { spawn "Telegram"; }
    Mod+Shift+S  hotkey-overlay-title="Open steam"     { spawn "steam"; }
    Mod+Shift+M  hotkey-overlay-title="Open spotify"   { spawn "spotify"; }
    Mod+W        hotkey-overlay-title="Random wallpaper" { spawn-sh "awww img -t any --transition-duration 0.5 \"$(find ~/wallpapers -type f | shuf -n1)\""; }

    Mod+C repeat=false { close-window; }

    // Управление звуком
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // Управление яркостью
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // Скриншоты
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Фокусировка окон
    Mod+H     { focus-column-left; }
    Mod+J     { focus-workspace-down; }
    Mod+K     { focus-workspace-up; }
    // Mod+U              { focus-workspace-down; }
    // Mod+I              { focus-workspace-up; }
    Mod+L     { focus-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
   
    // Перемещение окон
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    // Mod+Shift+U         { move-column-to-workspace-down; }
    // Mod+Shift+I         { move-column-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Перемещение между столами
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Перемещение окон между столами
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Перемещение столов
    // Mod+Shift+U         { move-workspace-down; }
    // Mod+Shift+I         { move-workspace-up; }

    // Переключение к предыдущему столу
    Mod+Tab { focus-workspace-previous; }

    // Складывание окон
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Переключение пресетов
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    // Полноэкранный режим
    Mod+F { maximize-column; }
    Mod+Ctrl+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+C { center-column; }

    // Размеры окна
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Плавающий режим
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Режим вкладок
    // Mod+W { toggle-column-tabbed-display; }
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    // Проброс в виртуалку
    // Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Выход из WM
    Mod+Shift+Q { quit; }
    
    // Отключение
    // Mod+Shift+P { power-off-monitors; }
}
